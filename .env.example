# Copy to .env and fill in. Never commit .env.

# --- AI (Google AI Studio) ---
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Auth: Google Sign-In (no passwords) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorised JavaScript origins: http://localhost:3000 and your live URL
GOOGLE_CLIENT_ID=
# Comma-separated staff emails. Only these accounts can open the staff desk.
ADMIN_EMAILS=
# Optional: only allow these email domains to sign in (admins always allowed), e.g. college.edu
ALLOWED_EMAIL_DOMAINS=
# 32+ random chars, signs session cookies. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local development only: lets you sign in by typing an email (ignored when NODE_ENV=production)
DEV_LOGIN=0

NODE_ENV=development
PORT=3000
